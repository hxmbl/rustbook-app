{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Book",
  "mainBinaryName": "rustbook",
  "version": "0.1.0",
  "identifier": "dev.hxmbl.rustbook",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": {
      "script": "./scripts/stage.sh",
      "wait": true
    },
    "beforeBuildCommand": {
      "script": "./scripts/stage.sh",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "The Rust Programming Language",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#f6f7f6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Education",
    "shortDescription": "The Rust Programming Language, offline",
    "longDescription": "The Rust Programming Language by Steve Klabnik, Carol Nichols and Chris Krycho, with contributions from the Rust community. The book is rendered when the app is built and read straight from the embedded copy, so it works without a network connection.",
    "copyright": "© The Rust Programming Language contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "education"
      }
    }
  }
}
